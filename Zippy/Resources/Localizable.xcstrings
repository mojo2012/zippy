    },
    "macFUSE is installed, but its FSKit extension is not registered, so macFUSE wants to load its kernel extension instead. To fix this, reinstall macFUSE and turn it on under File System Extensions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macFUSE ist installiert, aber seine FSKit-Erweiterung ist nicht angemeldet. Dann will macFUSE seine Kernel-Erweiterung laden. Abhilfe: macFUSE neu installieren und unter Dateisystemerweiterungen einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macFUSE is installed, but its FSKit extension is not registered, so macFUSE wants to load its kernel extension instead. To fix this, reinstall macFUSE and turn it on under File System Extensions."
          }
        }
      }
    },
