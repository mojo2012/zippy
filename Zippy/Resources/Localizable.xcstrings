      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zippy öffnet ZIP-, TAR-, 7z- und RAR-Archive als Laufwerke im Finder. Die Laufwerke stellt FUSE-T oder macFUSE bereit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zippy opens ZIP, TAR, 7z and RAR archives as drives in Finder. The drives are provided by FUSE-T or macFUSE."
          }
        }
      }
    },
