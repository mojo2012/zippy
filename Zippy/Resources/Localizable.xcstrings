    },
    "A ZIP password protects only file contents. Folders and empty files stay readable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ZIP-Passwort schützt nur Dateiinhalte. Ordner und leere Dateien bleiben lesbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ZIP password protects only file contents. Folders and empty files stay readable."
          }
        }
      }
    },
